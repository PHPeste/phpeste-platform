# API vista pelo navegador
NUXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API vista pelo servidor do Nuxt (na mesma rede do backend em produção, ex.: http://backend:8000/api/v1)
NUXT_API_INTERNAL_URL=http://localhost:8000/api/v1
# true só atrás de um proxy que reescreve X-Forwarded-Host (Caddy); nunca exposto direto
NUXT_TRUST_FORWARDED_HOST=false
# Por quanto tempo a resolução do host e o tema ficam em cache no servidor
NUXT_EDITION_CACHE_SECONDS=60
