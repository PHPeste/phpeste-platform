# Nome da aplicação, usado em e-mails, título de páginas e no Vite.
APP_NAME=PHPeste

# local | staging | production — muda comportamento de erro, cache e log.
APP_ENV=local

# Gerado por `php artisan key:generate`. Nunca compartilhar nem commitar preenchido.
APP_KEY=

# Mostra stack trace em erros quando true. Sempre false em produção.
APP_DEBUG=true

# URL base usada para gerar links absolutos (e-mails, assets).
APP_URL=http://localhost:8000

# Locale padrão da aplicação e de fallback quando uma tradução não existe.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Driver do modo de manutenção (`php artisan down`). file não precisa de banco.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Quantos workers o `php artisan serve` sobe (só em dev, sem Octane/FPM).
# PHP_CLI_SERVER_WORKERS=4

# Custo do hash de senha (bcrypt). Mais alto = mais seguro e mais lento.
BCRYPT_ROUNDS=12

# Canal e nível de log. stack escreve em vários canais; single é um arquivo só.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco relacional. mysql/3306 bate com os hostnames do infra/docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phpeste
DB_USERNAME=phpeste
DB_PASSWORD=phpeste

# Onde a sessão do usuário é guardada entre requisições.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Driver de broadcast de eventos em tempo real (WebSocket). log é um no-op para dev.
BROADCAST_CONNECTION=log

# Disco padrão de arquivos (local, s3, etc. — ver config/filesystems.php).
FILESYSTEM_DISK=local

# Fila usada por Horizon e pelos jobs dos módulos (webhooks, e-mails, QR).
QUEUE_CONNECTION=redis

# Onde o cache de aplicação é guardado.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis: fila, cache e sessão. redis/6379 bate com o serviço do docker-compose.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP de dev aponta para o Mailpit do docker-compose (inbox em localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@phpeste.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciais de bucket S3-compatível para mídia (logos, fotos). Vazio = desligado em dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Nome exposto ao front-end via Vite (build de assets do backend, se houver).
VITE_APP_NAME="${APP_NAME}"

# Origens com permissão de CORS (separadas por vírgula). Nunca "*" fora de local.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Limites de rate limit por rota sensível — tentativas por janela de decaimento em minutos.
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=1
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=5
RATE_LIMIT_PASSWORD_RESET_DECAY_MINUTES=1
RATE_LIMIT_CHECKOUT_ATTEMPTS=10
RATE_LIMIT_CHECKOUT_DECAY_MINUTES=1
RATE_LIMIT_WEBHOOKS_ATTEMPTS=60
RATE_LIMIT_WEBHOOKS_DECAY_MINUTES=1

# DSN do Sentry. Vazio = integração desligada (padrão).
SENTRY_LARAVEL_DSN=
